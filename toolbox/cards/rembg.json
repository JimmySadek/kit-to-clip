{
  "schema": 1,
  "id": "rembg",
  "name": "Object cutout (rembg)",
  "about": "cuts the main subject out of a picture: products, logos, objects, pets (people: use hf-cutout)",
  "kind": "pip",
  "maturity": "stable",
  "rank": 2,
  "size_mb": 450,
  "homepage": "https://github.com/danielgatis/rembg",
  "capabilities": [
    "cutout"
  ],
  "licence": {
    "spdx": "MIT",
    "usage": "separate-program",
    "model_spdx": "Apache-2.0",
    "model": "isnet-general-use (DIS, xuebinqin)",
    "url": "https://github.com/danielgatis/rembg"
  },
  "upstream": {
    "pypi": "rembg",
    "github": "danielgatis/rembg"
  },
  "pinned": "2.0.85",
  "install": {
    "packages": [
      "rembg[cpu]=={version}"
    ],
    "main": "python"
  },
  "smoke": {
    "timeout": 900,
    "steps": [
      {
        "sh": "ffmpeg -v error -y -f lavfi -i color=c=0xf4f1ea:s=640x480 -vf \"drawbox=x=220:y=140:w=200:h=200:color=0xd62828:t=fill,drawbox=x=280:y=200:w=80:h=80:color=0x1d3557:t=fill\" -frames:v 1 {scratch}/product.png"
      },
      {
        "sh": "{python} {skill}/toolbox/helpers/rembg_cutout.py {scratch}/product.png {scratch}/cut.png > {scratch}/cut.log"
      }
    ],
    "expect": [
      {
        "file": "{scratch}/cut.png",
        "min_bytes": 2000
      },
      {
        "file": "{scratch}/cut.log",
        "contains": "of the picture kept"
      }
    ]
  },
  "recipe": "recipes/hf-cutout.md",
  "fallback": "use the image with its background, or a soft mask"
}
